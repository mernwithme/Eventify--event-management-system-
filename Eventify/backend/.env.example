PORT=5000
MONGO_URI=mongodb://localhost:27017/eventify
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173

# ==========================================
# SMTP Email & OTP Configuration
# ==========================================
# Option 1: Gmail SMTP (Recommended for quick setup)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password (remove spaces)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Eventify" <your_email@gmail.com>

# Option 2: Custom / Corporate SMTP (Mailtrap, SendGrid, Brevo, etc.)
# If SMTP_HOST is provided, custom SMTP will be used instead of Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Eventify" <noreply@yourdomain.com>
